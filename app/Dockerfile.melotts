FROM python:3.10-slim

WORKDIR /app

# --- deps del sistema (ffmpeg + MeCab) ---
RUN apt-get update && apt-get install -y \
    ffmpeg git espeak-ng \
    mecab libmecab2 mecab-ipadic-utf8 \
    && rm -rf /var/lib/apt/lists/*

# MeCab busca este archivo; en Debian suele estar aquí
ENV MECABRC=/etc/mecabrc

COPY requirements-melotts.txt .

RUN pip install --no-cache-dir -r requirements-melotts.txt

COPY . .

CMD ["python", "app/controllers/listening/generate_audio.py"]
